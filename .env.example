# Copy to .env and set private values locally. Do not commit .env.
DATABASE_URL=postgresql+psycopg2://<username>:<password>@localhost:5432/FinanceFlow_db
FINANCEFLOW_DATABASE_NAME=FinanceFlow_db
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_TOKEN_TTL_MINUTES=30
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
